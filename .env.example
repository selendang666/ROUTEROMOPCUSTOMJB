# Oh My Omop - Router — Copy to .env, do not commit

# ── Server (mandatory) ───────────────────────────────
PORT=12800
PUBLIC_ORIGIN=http://127.0.0.1:12800

# ── Auth JWT (mandatory) ─────────────────────────────
APP_SECRET=change-me-32-chars-min
PROXY_API_KEY=change-me-proxy-key

# ── Console bootstrap (mandatory first boot) ─────────
DISABLE_LANDING_PAGE=false

# ── Database PostgreSQL  (mandatory) ────────────────
DATABASE_URL=postgres://ohmyomop_router:ohmyomop_router@127.0.0.1:5432/ohmyomop_router
#OHMYOMOP_ROUTER_DB_POOL_MAX=20
#OHMYOMOP_ROUTER_DB_STATEMENT_TIMEOUT_MS=10000
#OHMYOMOP_ROUTER_DB_IDLE_TXN_TIMEOUT_MS=30000

# Redis connection (optional, default in-memory)
#REDIS_URL=redis://127.0.0.1:6379/0

# ── WireGuard proxy pool ─────────────────────────────
# WireGuard is active by default; configs are read from this directory.
WIREPROXY_BIN=./bin/wireproxy.exe
WIREGUARD_CONFIG_DIR=./data/wireguard
WIREGUARD_START_PORT=11080

# ── Trust & network (overriding, default hashed) ─────
#TRUST_PROXY=false
#PUBLIC_ORIGIN=https://your.domain

# ── Telemetry — SQLite default, D1 optional ────────────
# D1 is selected only when both D1 values are configured; otherwise SQLite is used.
SQLITE_PATH=./data/telemetry.db
#TELEMETRY_D1_URL=https://api.cloudflare.com/client/v4/accounts/<id>/d1/database/<id>/query
#TELEMETRY_D1_TOKEN=

# ── Bounded runtime (overriding, 0 = adaptive) ───────
#OHMYOMOP_ROUTER_MAX_REQUEST_BODY_BYTES=1048576
#OHMYOMOP_ROUTER_MAX_STREAM_LINE_BYTES=262144
#OHMYOMOP_ROUTER_MAX_STREAM_EVENT_BYTES=1048576
#OHMYOMOP_ROUTER_MAX_STREAM_BUFFERED_BYTES=4194304
#OHMYOMOP_ROUTER_MAX_STREAM_BYTES=10485760
#OHMYOMOP_ROUTER_MAX_STREAM_EVENTS=10000
#OHMYOMOP_ROUTER_MAX_TRACKED_IPS=0
#OHMYOMOP_ROUTER_MAX_TRACKED_KEYS=0
#OHMYOMOP_ROUTER_GC_INTERVAL_MS=600000
#OHMYOMOP_ROUTER_REQUEST_LOGS=0

# ── Telemetry memory ──────────────────────────────────
#OHMYOMOP_ROUTER_TELEMETRY_CACHE_MB=32

# ── Overhead observability & transport tuning ──────
#OHMYOMOP_ROUTER_OVERHEAD_TRACKING=1
#OHMYOMOP_ROUTER_OVERHEAD_SAMPLE_RATE=1
#OHMYOMOP_ROUTER_OVERHEAD_SAMPLES_PER_PHASE=8192
#OHMYOMOP_ROUTER_OVERHEAD_STREAM_SAMPLE_RATE=0.01
#OHMYOMOP_ROUTER_DNS_CACHE_TTL_MS=60000
#OHMYOMOP_ROUTER_HEDGE_DELAY_MS=300

# ── IP bruteforce + rate limit (per IP) ──────
# Login/setup/reset failure threshold (count then ban for 5 days, reason=failed_login)
#BRUTEFORCE_MAX_FAILURES=10
#BRUTEFORCE_BAN_DURATION_MS=21600000
# Generic unauthorized false-hit threshold (10 then ban 30 minutes, reason=suspicious_activity)
#SUSPICIOUS_MAX_FAILURES=10
#SUSPICIOUS_BAN_DURATION_MS=1800000
# Open /v1/* requests/min per IP — first over-threshold request triggers 1h ban (reason=rate_limit_abuse)
#OPEN_ENDPOINT_RATE_LIMIT_PER_MIN=500
# Authenticated /console/api/* requests/min per IP — over-threshold triggers 1h ban
#CONSOLE_RATE_LIMIT_PER_MIN=200

# ── Server bind ──────────────────────────────────────
#HOST=0.0.0.0

# ── Routing transitions ──────────────────────────────
#OHMYOMOP_ROUTER_MAX_ROUTE_TRANSITION_ROUTES=4096
#OHMYOMOP_ROUTER_MAX_ROUTE_TRANSITIONS_PER_ROUTE=512

# ── Montana upstream headers ───────────────────────────
#MONTANA_UPSTREAM_ORIGIN=https://opencode.ai
#MONTANA_UPSTREAM_EXTRA_HEADERS={}
#MONTANA_SIGNATURE_SEED=

# ── Login tracking ───────────────────────────────────
#OHMYOMOP_ROUTER_LOGIN_MAX_TRACKED_IPS=10000

# ── Global rate limit ────────────────────────────────
#OHMYOMOP_ROUTER_RATE_LIMIT_MAX_REQUESTS=200
#OHMYOMOP_ROUTER_RATE_LIMIT_WINDOW_MS=60000

# ── Memory-constrained mode ──────────────────────────
#OHMYOMOP_ROUTER_LOW_MEM=false

# ── WireGuard WARP ───────────────────────────────────
#OHMYOMOP_ROUTER_ENABLE_WARP=false

# ── Codex proxy toggle ───────────────────────────────
#OHMYOMOP_ROUTER_CODEX_PROXY=true

